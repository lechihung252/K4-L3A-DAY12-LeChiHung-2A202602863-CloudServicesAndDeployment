# Thứ KHÔNG được copy vào build context / image.
# Bỏ sót .env = leak secret vào image. Bỏ sót .git = image phình to.
# KHÔNG ignore app/, utils/, requirements.txt — image cần chúng để chạy.

# Git & CI
.git
.gitignore
.github

# Secrets — không bao giờ được nằm trong image
.env
.env.*
*.pem
*.key

# Python
__pycache__
*.py[cod]
.venv
venv
env
.pytest_cache
*.egg-info

# Không cần lúc runtime
tests
screenshots
*.md
docker-compose.yml
nginx
railway.toml
render.yaml
grade.py

# OS / editor
.DS_Store
.idea
.vscode
*.log
